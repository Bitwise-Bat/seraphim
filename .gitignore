# ==============================
# Seraphim 2D - .gitignore
# ==============================

# --- CMake / build ---
build/
build-*/
out/
cmake-build-*/
CMakeCache.txt
CMakeFiles/
CMakeScripts/
CMakeUserPresets.json
cmake_install.cmake
install_manifest.txt
compile_commands.json
CTestTestfile.cmake
Testing/
_deps/
*.ninja
.ninja_deps
.ninja_log

# --- C/C++ compiled artifacts ---
*.o
*.obj
*.a
*.lib
*.so
*.so.*
*.dylib
*.dll
*.exe
*.pdb
*.ilk
*.exp
*.idb
*.pch
*.gch
*.ipch
*.d
*.tlog
*.lastbuildstate

# --- Emscripten / WebAssembly outputs ---
*.wasm
*.wasm.map
*.wat
*.js.mem
*.data
*.worker.js

# --- Package managers (C++) ---
vcpkg_installed/
.conan/
conan.lock

# --- Node / React UI ---
node_modules/
dist/
dist-ssr/
.vite/
.parcel-cache/
.next/
coverage/
*.tsbuildinfo
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.pnpm-store/
.eslintcache
.env
.env.*
!.env.example

# --- IDEs ---
# CLion / JetBrains
.idea/
*.iml
# Visual Studio
.vs/
*.user
*.suo
*.sln.docstates
*.VC.db
*.VC.opendb
# VS Code
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
# clangd / cache
.cache/
.clangd/

# --- OS junk ---
# Windows
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/
*.lnk
# macOS
.DS_Store
.AppleDouble
.LSOverride
._*
# Linux
*~
.directory

# --- Logs / temp ---
*.log
*.tmp
*.swp
*.bak
imgui.ini
